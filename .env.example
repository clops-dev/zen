# Postgres connection
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Server port
PORT=8787

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# bcrypt cost factor (higher = slower/more secure, 12 is a reasonable default)
BCRYPT_COST=12

# Bootstrap admin — created automatically on first run if no admin exists yet.
# Change the password via the dashboard (or directly in the DB) after first login.
ADMIN_EMAIL=admin@zen.com
# Must be at least 8 characters (enforced by env.ts zod schema).
ADMIN_PASSWORD=change-me-8

# Default monthly token budget for new free-tier signups
DEFAULT_FREE_TOKEN_BUDGET=50000

# Optional: OpenRouter API key. If set AND the openrouter provider row
# has no api_key stored yet, it's copied into Postgres on boot so the
# gateway is usable from the first request. Postgres is the source of
# truth — once a key is set via the admin UI, this env var is ignored
# for that row. Leave blank if you prefer to set the key via the admin UI.
OPENROUTER_API_KEY=

# Optional: AgentRouter (Anthropic-compatible) API key. Same semantics
# as OPENROUTER_API_KEY above — copied into the agentrouter provider row
# on boot only if that row has no api_key yet, never overwriting a key
# set via the admin UI. AgentRouter uses Bearer auth (Authorization:
# Bearer <token>) and an Anthropic-style /messages endpoint, NOT the
# OpenAI chat-completions endpoint.
ANTHROPIC_AUTH_TOKEN=

# Optional: base URL for the AgentRouter (Anthropic-compatible) provider.
# Must NOT have a trailing /v1 — the Anthropic SDK appends /messages to
# whatever baseURL it is given, so injecting /v1 here would break the
# final endpoint. Defaults to https://agentrouter.org. Set this to a
# different deployment (mirror, staging) only if you also update the
# agentrouter provider row's base_url via the admin UI / DB.
ANTHROPIC_BASE_URL=

# Optional: AgentRouter (OpenAI-compatible) API key. Copied into the
# agentrouter provider row on boot only if that row has no api_key yet,
# never overwriting a key set via the admin UI. Sent as
# Authorization: Bearer <token> against https://agentrouter.org/v1
# (chat-completions endpoint). Used by the openai-compatible adapter —
# see migration 010_agentrouter_openai_compatible.sql.
AGENTROUTER_API_KEY=

# Public URL of this gateway. Sent on every upstream request to
# OpenRouter as the HTTP-Referer header — OpenRouter uses it for
# attribution and to keep free-tier callers from being deprioritized.
APP_URL=http://192.168.253.155:8787

# Public URL used in the browser-facing device auth verification link sent to the CLI.
# Optional for local dev — the gateway constructs it from the incoming request's host/protocol
# if unset. Set this to the real public URL once deployed (e.g. https://gateway.yourdomain.com)
# so the CLI always receives the correct link regardless of internal hostnames or load balancers.
WEB_URL=

# Optional upstream timeouts (ms). Omit to use env.ts defaults:
#   UPSTREAM_TIMEOUT_MS_NON_STREAMING — default 30 000 (30 s)
#   UPSTREAM_CONNECT_TIMEOUT_MS — default 10 000 (10 s)
#   UPSTREAM_FIRST_TOKEN_TIMEOUT_MS — default 120 000 (2 min)
#   UPSTREAM_IDLE_TIMEOUT_MS_STREAMING — default 120 000 (2 min)
#   UPSTREAM_MAX_STREAM_DURATION_MS — default 600 000 (10 min)
